# Copy to .env beside composer.json and enter your actual configuration values.
# The shared loader reads .env for web requests and CLI utilities after composer install.
# Existing server/shell environment variables take precedence over .env values.
# Never use the previous source-code password: rotate it before deployment.
DB_HOST=localhost
DB_USER=replace_with_database_user
DB_PASS=replace_with_rotated_database_password
DB_NAME=replace_with_database_name
SITE_URL=https://www.edtech.hivecolab.com
DB_PORT=3306
# Required for any remote DB_HOST. Use the CA certificate for your database server.
DB_SSL_CA=
# Generate using: php bin/secure-storage.php generate-key
# Keep this key outside the database, document root, and encrypted backups.
APP_ENCRYPTION_KEY=
